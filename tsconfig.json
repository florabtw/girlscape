{
    "compilerOptions": {
        "rootDir": ".",
        "composite": true,
        "noEmit": true,
        // Just have a build folder be the output folder by default
        "outDir": "build",
        "paths": {
            "#*": ["./src/*.js"]
        },

        // Fuck JS
        "allowJs": true,
        // sets allowSyntheticDefaultImports
        "esModuleInterop": true,
        // Check d.ts types
        "skipLibCheck": false,

        "target": "esnext",
        "module": "preserve",
        /* 
         * Decorators are rolled into esnext
         * dom/dom-iterable are generated by ts
         */
        "lib": ["esnext", "ESNext.Iterator", "dom", "dom.iterable"],
        
        // we're not bundling obviously, but this setting allows tsx to omit extensions.
        "moduleResolution": "bundler",

        "moduleDetection": "force",
        "strict": true,

        // These are nice but annoying when writing code.
        "noUnusedLocals": false,
        "allowUnusedLabels": true,
        "noUnusedParameters": false,
        "allowImportingTsExtensions": false,

        // Required when using nodes built-in TS capabilities. To use non-eraseable TS syntax, you'll have to do a build.
        "erasableSyntaxOnly": true,

        "resolveJsonModule": true,
        "verbatimModuleSyntax": true,
        "useDefineForClassFields": true,
        "noUncheckedIndexedAccess": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        "types": ["node"]
    },
    // json extensions have to be included manually
    "include": [
        "src/**/*", "types/**/*", "src/**/*.json"
    ]
}